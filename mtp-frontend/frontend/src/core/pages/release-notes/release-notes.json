                                    "level": 3,
                                    "data": "Manual Grouping",
                                    "content": [
                                        {
                                            "type": "text",
                                            "indent": true,
                                            "data": "You can create groups by simply selecting the relevant stores you are interested in and providing appropriate name."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
